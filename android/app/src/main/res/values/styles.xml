<resources>

    <!-- Light theme so native Picker dropdown/dialog stays readable (not dark-mode black). -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="alertDialogTheme">@style/ReportPickerDialogTheme</item>
        <item name="android:dropDownListViewStyle">@style/ReportPickerDropDownList</item>
        <item name="android:spinnerDropDownItemStyle">@style/ReportPickerDropDownItem</item>
    </style>

    <style name="ReportPickerDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#000000</item>
    </style>

    <style name="ReportPickerDropDownList" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:background">#FFFFFF</item>
    </style>

    <style name="ReportPickerDropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">#000000</item>
        <item name="android:background">#FFFFFF</item>
    </style>

</resources>
